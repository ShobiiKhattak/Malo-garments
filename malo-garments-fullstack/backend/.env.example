# Copy this file to .env and fill in your real values

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=malo_garments

# Server
PORT=5000

# JWT secrets (use long random strings in production)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

ADMIN_JWT_SECRET=change_this_to_a_different_long_random_secret
ADMIN_JWT_EXPIRES_IN=1d

# ── Phone Login (OTP via SMS) ──────────────────────────────────────────────────
# Get these from: https://console.twilio.com
# If left blank, OTP codes are logged to the server console instead of texted —
# lets you build/test phone login before wiring up a real Twilio account.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ── Google Sign-In ──────────────────────────────────────────────────────────────
# Get one at: https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID → Web application → add http://localhost:5173 as an
# authorized JavaScript origin). Also set VITE_GOOGLE_CLIENT_ID to the same
# value in malo-react/.env for the frontend button to appear.
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ── AI Size/Fit Assistant + Design Studio realistic preview (Google Gemini) ─────
# Get a key at: https://aistudio.google.com/apikey
# If left blank, size recommendations fall back to a standard size-chart lookup,
# and Design Studio's "Generate Realistic Photo" button is disabled (the SVG
# sketch preview still works). Image generation is billed per image once past
# the free tier — needs a Google Cloud billing account on the key's project.
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Marketing Automation Pipeline ─────────────────────────────────────────────
# Run migration 004 first: backend/db/migrations/004_add_marketing_tables.sql
#
# Meta (Facebook + Instagram) — Graph API v20.0
# Get these from: https://developers.facebook.com/apps/
META_FB_PAGE_ID=your_facebook_page_id
META_FB_PAGE_ACCESS_TOKEN=your_page_long_lived_access_token
META_IG_USER_ID=your_instagram_business_account_id

# TikTok — Content Posting API v2
# Get these from: https://developers.tiktok.com/
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_OPEN_ID=your_tiktok_open_id

# Creative generation
# ffmpeg must be installed and on PATH for video generation.
# Download: https://ffmpeg.org/download.html
#
# Optional: path to an MP3/AAC file to use as background music in video ads.
# Leave blank to generate silent (no-audio) videos.
MARKETING_BG_MUSIC_PATH=

# Optional: override per-platform cron schedules (set via API /api/marketing/settings
# or directly in the social_post_settings DB row). Defaults: 8am, 1pm, 7pm daily.
# MARKETING_CRON_MORNING=0 8 * * *
# MARKETING_CRON_AFTERNOON=0 13 * * *
# MARKETING_CRON_EVENING=0 19 * * *

# ── CJ Dropshipping API ────────────────────────────────────────────────────────
# Sign up at: https://app.cjdropshipping.com
# Get API credentials from: Account → Settings → Developer
CJ_EMAIL=your_cj_account_email
CJ_API_SECRET=your_cj_api_password

# Delivery window shown in the "Order shipped" email (working days)
DELIVERY_DAYS_MIN=3
DELIVERY_DAYS_MAX=5
